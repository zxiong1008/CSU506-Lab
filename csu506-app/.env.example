# CSU 506 Project 2 - Frontend Environment Configuration
# Copy this file to .env.local and adjust values as needed

# API Base URL (for connecting to the Python API backend)
# Default: http://localhost:8000
# For Docker: http://api:8000
# For production: https://your-api-domain.com
VITE_API_URL=http://localhost:8000

# Debug mode (set to true for more verbose console output)
VITE_DEBUG=false
